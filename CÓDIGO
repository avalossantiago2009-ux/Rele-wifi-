#include <WiFi.h>
#include <WebServer.h>
#include "BluetoothSerial.h"

// WIFI
const char* ssid = "NOMBRE_WIFI";
const char* password = "CONTRASENA";

// HARDWARE
#define RELE 18

// SERVICIOS
WebServer server(80);
BluetoothSerial SerialBT;

// ESTADO
bool estadoRele = false;

// CONTROL DEL RELE
void actualizarRele() {
digitalWrite(RELE, estadoRele ? HIGH : LOW);
}

// PAGINA WEB
void paginaPrincipal() {
String html = R"rawliteral(

  <!DOCTYPE html>    <html>  
  <head>  
    <meta name="viewport" content="width=device-width, initial-scale=1">  
    <title>Rele inteligente</title>  
    <style>  
      body {  
        background:#151923;  
        color:white;  
        font-family:Arial;  
        text-align:center;  
        padding-top:50px;  
      }  
      .card {  
        background:#242b3a;  
        padding:30px;  
        margin:auto;  
        width:75%;  
        max-width:350px;  
        border-radius:20px;  
      }  
      button {  
        padding:18px 45px;  
        border:0;  
        border-radius:12px;  
        font-size:20px;  
        color:white;  
        background:#168c55;  
        margin-top:20px;  
      }  
      .off {background:#bd3545;}  
    </style>  
  </head>  
  <body>  
    <h2>ESP32 - Rele inteligente</h2>  
    <div class="card">  
      <h3>Estado del rele</h3>  
      <h1 id="estado">---</h1>  
      <button id="boton" onclick="cambiar()">...</button>  
    </div>  
    <script>  
      let encendido = false;  async function actualizar() {  
    let r = await fetch('/estado');  
    encendido = await r.text() === '1';  
    document.getElementById('estado').innerText =  
      encendido ? 'ENCENDIDO' : 'APAGADO';  
    let b = document.getElementById('boton');  
    b.innerText = encendido ? 'APAGAR' : 'ENCENDER';  
    b.className = encendido ? 'off' : '';  
  }  

  async function cambiar() {  
    await fetch('/toggle');  
    actualizar();  
  }  

  actualizar();  
  setInterval(actualizar, 1500);  
</script>

  </body>  
  </html>  
  )rawliteral";  server.send(200, "text/html", html);
}

// CAMBIAR ESTADO
void cambiarEstado() {
estadoRele = !estadoRele;
actualizarRele();
server.send(200, "text/plain", "OK");
}

// CONSULTAR ESTADO
void consultarEstado() {
server.send(200, "text/plain",
estadoRele ? "1" : "0");
}

// BLUETOOTH
void controlarBluetooth() {
if (SerialBT.available()) {
char comando = SerialBT.read();

if (comando == '1') {  
  estadoRele = true;  
}  
else if (comando == '0') {  
  estadoRele = false;  
}  
else if (comando == '2') {  
  estadoRele = !estadoRele;  
}  
else {  
  return;  
}  

actualizarRele();  

SerialBT.println(  
  estadoRele ? "RELE ENCENDIDO" : "RELE APAGADO"  
);

}
}

void setup() {
Serial.begin(115200);

pinMode(RELE, OUTPUT);
digitalWrite(RELE, LOW);

// BLUETOOTH
SerialBT.begin("Rele_Inteligente");
Serial.println("Bluetooth iniciado");

// WIFI
WiFi.begin(ssid, password);

Serial.print("Conectando a WiFi");

unsigned long inicio = millis();

while (WiFi.status() != WL_CONNECTED &&
millis() - inicio < 15000) {
delay(500);
Serial.print(".");
}

if (WiFi.status() == WL_CONNECTED) {
Serial.println("\nWiFi conectado");
Serial.println(WiFi.localIP());

server.on("/", paginaPrincipal);  
server.on("/toggle", cambiarEstado);  
server.on("/estado", consultarEstado);  

server.begin();

} else {
Serial.println("\nWiFi no disponible");
Serial.println("Bluetooth sigue funcionando");
}
}

void loop() {
if (WiFi.status() == WL_CONNECTED) {
server.handleClient();
}

controlarBluetooth();
}
